{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-i18n.mjs\"",
            "timeout": 15,
            "statusMessage": "Comprobando paridad ES/PT…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/confirm-git.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
